<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.lodgebilling.LoginController"
      alignment="CENTER"
      spacing="15"
      prefWidth="450"
      prefHeight="350"
      style="-fx-background-color: #f4f7fb;">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text=" 5 STARS HOTEL  "
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1f3c88;"/>

    <Label text="Login to continue"
           style="-fx-font-size: 16px; -fx-text-fill: #555555;"/>

    <TextField fx:id="usernameField"
               promptText="Username"
               prefHeight="40"
               maxWidth="300"/>

    <PasswordField fx:id="passwordField"
                   promptText="Password"
                   prefHeight="40"
                   maxWidth="300"/>

    <Button text="LOGIN"
            onAction="#handleLogin"
            prefWidth="150"
            prefHeight="40"
            style="-fx-background-color: #1f3c88;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-background-radius: 5;"/>

    <Label fx:id="messageLabel"
           text=""
           style="-fx-text-fill: #d32f2f;"/>

</VBox>